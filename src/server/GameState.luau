-- GameState.luau
-- All mutable game state lives here and nowhere else: one record per
-- player (cash, pads, rebirths, lock, gacha rolls, collection) plus the
-- plot assignment table and the shared world clock (tsunami countdown).
-- In-memory only by design -- no DataStore; a session is a fresh bazaar.
--
-- Economy shape:
--   * Each placed brainrot adds income*multiplier to its owner's stored
--     cash every second. Stored cash is only banked by standing on the
--     green collect pad, which is what makes the dash home matter.
--   * Rebirth wipes cash and brainrots for a permanent +0.75x multiplier
--     per rebirth, and costs 10,000 * 3^rebirths.

local GameState = {}

GameState.START_CASH = 150
GameState.PADS_PER_BASE = 6
GameState.LOCK_SECONDS = 60
GameState.TSUNAMI_PERIOD = 180
GameState.TSUNAMI_WARNING = 10
GameState.REBIRTH_BASE_COST = 10000
GameState.REBIRTH_MULTIPLIER_STEP = 0.75
GameState.GACHA_BASE_COST = 500

export type PadState = {
	defId: string,
	mutation: string?,
	model: Model?,
	stored: number, -- not used per-pad; kept for future per-pad readouts
}

export type PlayerState = {
	player: Player,
	plotIndex: number, -- 1..8, 0 = none yet
	cash: number,
	stored: number, -- unbanked cash generated by placed brainrots
	rebirths: number,
	pads: { PadState? }, -- index 1..PADS_PER_BASE
	lockedUntil: number, -- os.clock() deadline; locked while > now
	gachaRolls: number,
	everOwned: { [string]: boolean }, -- collection index memory
}

local players: { [Player]: PlayerState } = {}
local plotOwners: { [number]: Player? } = {}

-- Seconds until the next tsunami strikes; init.server owns the clock and
-- publishes it here so GameState stays the one place clients read from.
GameState.tsunamiIn = GameState.TSUNAMI_PERIOD
GameState.tsunamiWarning = false

function GameState.multiplier(state: PlayerState): number
	return 1 + state.rebirths * GameState.REBIRTH_MULTIPLIER_STEP
end

function GameState.rebirthCost(state: PlayerState): number
	return GameState.REBIRTH_BASE_COST * (3 ^ state.rebirths)
end

-- Gacha price climbs with every roll the player has ever made, so the
-- machine stays a money sink late into a session.
function GameState.gachaCost(state: PlayerState): number
	return math.floor(GameState.GACHA_BASE_COST * (1.6 ^ state.gachaRolls) + 0.5)
end

function GameState.join(player: Player): PlayerState
	local state: PlayerState = {
		player = player,
		plotIndex = 0,
		cash = GameState.START_CASH,
		stored = 0,
		rebirths = 0,
		pads = {},
		lockedUntil = 0,
		gachaRolls = 0,
		everOwned = {},
	}
	players[player] = state
	-- Claim the first free plot.
	for i = 1, 8 do
		if plotOwners[i] == nil then
			plotOwners[i] = player
			state.plotIndex = i
			break
		end
	end
	return state
end

function GameState.leave(player: Player)
	local state = players[player]
	if state and state.plotIndex > 0 then
		plotOwners[state.plotIndex] = nil
	end
	players[player] = nil
end

function GameState.get(player: Player): PlayerState?
	return players[player]
end

function GameState.all(): { [Player]: PlayerState }
	return players
end

function GameState.isLocked(state: PlayerState): boolean
	return state.lockedUntil > os.clock()
end

function GameState.lockSecondsLeft(state: PlayerState): number
	return math.max(0, math.ceil(state.lockedUntil - os.clock()))
end

-- First empty pad index, or nil when the base is full.
function GameState.freePad(state: PlayerState): number?
	for i = 1, GameState.PADS_PER_BASE do
		if state.pads[i] == nil then
			return i
		end
	end
	return nil
end

function GameState.placedCount(state: PlayerState): number
	local n = 0
	for i = 1, GameState.PADS_PER_BASE do
		if state.pads[i] ~= nil then
			n += 1
		end
	end
	return n
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BrainrotData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BrainrotData"))

-- Total $/s of placed brainrots BEFORE the rebirth multiplier; callers
-- multiply where the number is spent or displayed.
function GameState.baseIncome(state: PlayerState): number
	local total = 0
	for i = 1, GameState.PADS_PER_BASE do
		local pad = state.pads[i]
		if pad then
			local def = BrainrotData.BY_ID[pad.defId]
			if def then
				total += BrainrotData.incomeOf(def, pad.mutation)
			end
		end
	end
	return total
end

-- The richest single pad a player owns, by income: the thief's target
-- picker and the "best brainrot" readout both start from this.
function GameState.richestPad(state: PlayerState): (number?, number)
	local bestIndex, bestIncome = nil, 0
	for i = 1, GameState.PADS_PER_BASE do
		local pad = state.pads[i]
		if pad then
			local def = BrainrotData.BY_ID[pad.defId]
			if def then
				local inc = BrainrotData.incomeOf(def, pad.mutation)
				if inc > bestIncome then
					bestIndex, bestIncome = i, inc
				end
			end
		end
	end
	return bestIndex, bestIncome
end

-- A plain-data snapshot for the client HUD and collection index. Models
-- and other Instances never cross the remote; ids and numbers only.
function GameState.snapshot(state: PlayerState)
	local owned = {}
	for id in pairs(state.everOwned) do
		table.insert(owned, id)
	end
	local pads = {}
	for i = 1, GameState.PADS_PER_BASE do
		local pad = state.pads[i]
		if pad then
			pads[i] = { defId = pad.defId, mutation = pad.mutation or "" }
		end
	end
	return {
		cash = math.floor(state.cash),
		stored = math.floor(state.stored),
		income = math.floor(GameState.baseIncome(state) * GameState.multiplier(state)),
		rebirths = state.rebirths,
		multiplier = GameState.multiplier(state),
		rebirthCost = GameState.rebirthCost(state),
		gachaCost = GameState.gachaCost(state),
		lockLeft = GameState.lockSecondsLeft(state),
		tsunamiIn = math.ceil(GameState.tsunamiIn),
		tsunamiWarning = GameState.tsunamiWarning,
		plotIndex = state.plotIndex,
		owned = owned,
		pads = pads,
	}
end

return GameState
